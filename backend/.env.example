# Copie este archivo a backend/.env y complete los valores.
# Nunca commitee .env ni secretos reales.

APP_NAME=Visualizador de Ponches · César Iglesias
APP_ENV=development
# En producción use un valor aleatorio de 48+ caracteres.
# Linux/macOS: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes exactos del frontend. Separe por coma.
CORS_ORIGINS=http://localhost:3007,http://127.0.0.1:3007
ENABLE_DOCS=true

# Primer administrador. Solo se usa si backend/data/app_users.json no existe.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrador
# Mínimo 10 caracteres, letras y números. No use admin123.
BOOTSTRAP_ADMIN_PASSWORD=

# SQL Server
DB_SERVER=DESKTOP-JGB8EAN\SQLEXPRESS
DB_NAME=BioTime
DB_AUTH=windows
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Tablas visibles en /api/schema (coma separada)
SCHEMA_ALLOWED_TABLES=punches
