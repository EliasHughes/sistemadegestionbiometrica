# Copia:  copy .env.example .env
# Este archivo es de la COPIA (puertos 8015/3015). No uses el .env de producción.

APP_NAME=Sistema de Gestion Biometrica
APP_ENV=development
APP_VERSION=2.0.0-dev

# Obligatorio. Genere uno nuevo, distinto al de produccion:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend de ESTA copia
CORS_ORIGINS=http://localhost:3015,http://127.0.0.1:3015
ENABLE_DOCS=true

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NAME=Administrador
# Minimo 10 caracteres, letras y numeros. Distinto a produccion.
BOOTSTRAP_ADMIN_PASSWORD=

# SQL Server de desarrollo (puede ser la misma instancia, pero confirme que no escribe datos de prod sin querer)
DB_SERVER=DESKTOP-JGB8EAN\SQLEXPRESS
DB_NAME=BioTime
DB_AUTH=windows
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

SCHEMA_ALLOWED_TABLES=punches

# ============================================================
# FIORELLA / OPENROUTER
# ============================================================

FIORELLA_PROVIDER=openrouter

OPENROUTER_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

FIORELLA_MODEL=openrouter/free

FIORELLA_MAX_HISTORY=20

FIORELLA_AI_RETRIES=2

FIORELLA_AI_TIMEOUT=45

FIORELLA_MONITOR_INTERVAL=300